# Runtime defaults; platforms may override PORT. NODE_ENV is managed by Next.js.
PORT=3000
HOSTNAME=0.0.0.0

# Admin-only dashboard writes. Use a unique, long random password (32+ characters).
ADMIN_PASSWORD=
# Scheduler bearer token for POST /api/cron/forecast (use a separate random secret).
CRON_SECRET=

# Storage: when BOTH Turso values are set, all application records use libSQL/Turso.
# If either is missing, the app uses local JSON files instead; existing local data is
# never copied to Turso automatically. Use the admin backup/restore flow explicitly.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Fallback local JSON directory (default: ./.data). Only set persistent=true when
# this path is backed by a durable mounted volume; otherwise the health API warns.
AURUM_DATA_DIR=
AURUM_STORAGE_PERSISTENT=false

# Optional: configure one server-side AI provider for forecast commentary.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional. Enables the official FRED API for the U.S. 10Y TIPS real yield (DFII10).
FRED_API_KEY=

# Nepal closure list: comma-separated ISO dates (YYYY-MM-DD); Saturdays are closed.
# Sunday is treated as a working day unless included here.
NEPAL_PUBLIC_HOLIDAYS=

# Stage 2 optional feeds / clearly manual assumptions.
# CME API entitlement/OAuth bearer token; no FedWatch probabilities without valid access.
CME_FEDWATCH_BEARER_TOKEN=
CME_FEDWATCH_BASE_URL=https://markets.api.cmegroup.com/fedwatch/v1
CME_APPLICATION_NAME=Aurum Nepal
CME_APPLICATION_VENDOR=Aurum

# Optional SI=F silver correlation history. Disabled by default.
AURUM_ENABLE_SILVER_CORRELATION=false

# MCX ticker is a quote proxy unless its unit is verified. Enable model use only if INR per 10g.
AURUM_MCX_SYMBOL=GOLD.MCX
AURUM_MCX_QUOTE_UNIT=

# Optional manual CBIC duty reference. Verify the official notice and enter its date/source.
AURUM_INDIA_IMPORT_DUTY_PCT=
AURUM_INDIA_IMPORT_DUTY_AS_OF=
AURUM_INDIA_IMPORT_DUTY_SOURCE_URL=

# Optional comparison baselines. Without these, no duty-change factor is scored.
AURUM_INDIA_IMPORT_DUTY_BASELINE_PCT=
AURUM_NEPAL_DUTY_BASELINE_PCT=
